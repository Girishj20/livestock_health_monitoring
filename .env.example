# ==============================================================================
# Livestock Health Monitoring System - Environment Configuration Template
# Copy this file to '.env' and modify the values for your local environment.
# DO NOT commit real secrets or credentials to GitHub!
# ==============================================================================

# Flask Application Settings
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-secure-random-key-in-production-use-secrets-token-hex-32

# Database Connection (Default: SQLite local database in instance directory)
# For MySQL / MariaDB: mysql+pymysql://user:password@localhost:3306/livestock_health_monitoring
DATABASE_URL=sqlite:///instance/livestock_health.db

# Machine Learning Models Directory
MODEL_DIR=models

# File Upload Configuration
UPLOAD_FOLDER=app/static/uploads/animals
MAX_CONTENT_LENGTH=16777216

# Security & Session Settings
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME_DAYS=7

# Seed Demo Data Flag (Set to 1 to automatically seed sample data on fresh init)
SEED_SAMPLE_DATA=1
